# ROA Services — environment variables (example). Copy to .env for local dev.
# NEVER commit .env. These names are read by src/db/index.ts and src/server/api/auth.middleware.ts.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=2592000
NODE_ENV=development
PORT=3000
