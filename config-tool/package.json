{
  "name": "roaserv-config",
  "version": "1.0.0",
  "description": "ROA Services — Backend/Supabase & Frontend Base URL configuration tool",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.roaserv.config",
    "productName": "ROA Services Config",
    "files": ["main.js", "index.html", "preload.js"],
    "win": {
      "target": "nsis",
      "artifactName": "ROA-Services-Config-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}
