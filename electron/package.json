{
  "name": "roaserv-desktop",
  "version": "1.0.0",
  "description": "ROA Services — desktop launcher (backend + frontend dans le meme processus)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "copy-assets": "node copy-assets.cjs",
    "pack": "npm run copy-assets && electron-builder --dir",
    "dist": "npm run copy-assets && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.roaserv.desktop",
    "productName": "ROA Services",
    "files": [
      "main.js",
      "preload.js",
      "api-bundle.cjs",
      "browser/**/*",
      "roaserv.config.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "../release"
    },
    "win": {
      "target": "nsis",
      "icon": "../config-tool/assets/icon.ico"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  }
}
